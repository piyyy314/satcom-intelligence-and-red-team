{
  "name": "ghost-watch-c2",
  "version": "1.0.0",
  "description": "Satellite communications (SATCOM) intelligence, monitoring, and red-team audit terminal",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --outfile=server.js --format=esm --packages=external",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "keywords": [
    "satcom",
    "satellite",
    "sdr",
    "dsss",
    "cybersecurity",
    "red-team",
    "telemetry",
    "gemini-api"
  ],
  "author": "GHOST-WATCH Labs",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.4",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.4",
    "@types/express": "^4.17.21"
  }
}
